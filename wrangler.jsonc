{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "espresso-shared-diary",
  "main": "worker.ts",
  "compatibility_date": "2026-11-11",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
